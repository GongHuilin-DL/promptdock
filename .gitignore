# ============================================================
# PromptDock · .gitignore
# 内置示例数据（data/prompts/ 下两个 JSON）需要入库，所以这里
# 只忽略「运行时产生 / 用户私有」的部分，不忽略整个 data/。
# ============================================================

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
.installed.cfg
build/
dist/
pip-wheel-metadata/
.Python

# ---------- 虚拟环境 / 环境变量 ----------
.venv/
venv/
env/
ENV/
.env
.env.*
!.env.example

# ---------- 编辑器 / 操作系统 ----------
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ---------- 测试 / 类型检查 / 覆盖率 ----------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.coverage
.coverage.*
htmlcov/
.ipynb_checkpoints/

# ---------- Gradio 运行时 ----------
.gradio/
gradio_cached_examples/
flagged/
tmp/
*.tmp
*.log

# ---------- 本项目运行时产物 ----------
# 导出的 .txt、界面新建的默认写入文件、私有补充数据
data/exports/
data/prompts/99_自定义提示语.json
data/prompts/*_private*.json
data/prompts/*_private*.jsonl
data/prompts/*_private*.csv
data/prompts/我的*
data/config/settings.local.json

# 若希望整个本地提示语库都不入库，取消下一行注释：
# data/

# ---------- 发布打包产物 ----------
*.zip
promptdock.zip
sd_prompt_manager.zip

# ---------- 其它 ----------
*.bak
*.orig
*.rej
